{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucianoon/scoreparity/schema/report-v1.schema.json",
  "title": "scoreparity report, schema version 1",
  "description": "Output of `scoreparity compare --json`. Fields may be added in minor releases; removing or renaming a field requires a new schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "failed_gates",
    "gates",
    "summary",
    "config",
    "inputs",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "failed_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "passed",
          "value",
          "threshold",
          "description",
          "details"
        ],
        "properties": {
          "name": {
            "enum": [
              "coverage",
              "nonfinite",
              "parity_gate_configured",
              "max_abs_diff",
              "quantile_abs_diff",
              "mean_diff_equivalence",
              "decision_flips",
              "top_k_overlap",
              "auc_difference",
              "label_agreement",
              "transitions",
              "class_prevalence",
              "kappa",
              "quality_difference",
              "tv_distance",
              "invalid_rate",
              "stability",
              "schema_valid_rate"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "field": {
            "type": "string",
            "description": "structured outputs: the field the gate checked"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "n_reference",
        "n_candidate",
        "n_matched_finite",
        "n_missing",
        "n_extra",
        "n_nonfinite_mismatch",
        "n_nonfinite_both"
      ],
      "properties": {
        "n_reference": {
          "type": "integer",
          "minimum": 1
        },
        "n_candidate": {
          "type": "integer",
          "minimum": 0
        },
        "n_matched_finite": {
          "type": "integer",
          "minimum": 0
        },
        "n_missing": {
          "type": "integer",
          "minimum": 0
        },
        "n_extra": {
          "type": "integer",
          "minimum": 0
        },
        "n_nonfinite_mismatch": {
          "type": "integer",
          "minimum": 0
        },
        "n_nonfinite_both": {
          "type": "integer",
          "minimum": 0
        },
        "abs_diff_quantiles": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "abs_diff_histogram": {
          "type": "object",
          "required": [
            "zero",
            "decades"
          ],
          "properties": {
            "zero": {
              "type": "integer",
              "minimum": 0
            },
            "decades": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "exponent",
                  "count"
                ],
                "properties": {
                  "exponent": {
                    "type": "integer"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "mean_diff": {
          "type": "number"
        },
        "identical_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spearman": {
          "type": [
            "number",
            "null"
          ]
        },
        "auc": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reference",
            "candidate",
            "delta",
            "delta_ci90"
          ],
          "properties": {
            "reference": {
              "type": "number"
            },
            "candidate": {
              "type": "number"
            },
            "delta": {
              "type": "number"
            },
            "delta_ci90": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "kappa": {
          "type": "number"
        },
        "confusion": {
          "type": "object",
          "required": [
            "classes",
            "counts"
          ],
          "properties": {
            "classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "counts": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "prevalence": {
          "type": "object"
        },
        "tv_quantiles": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "invalid_share": {
          "type": "object",
          "required": [
            "reference",
            "candidate"
          ],
          "properties": {
            "reference": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "candidate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "reference",
              "candidate"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "reference": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "candidate": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "difference": {
                "type": "number"
              }
            }
          }
        },
        "stability": {
          "type": "object",
          "required": [
            "reference",
            "candidate"
          ],
          "properties": {
            "reference": {
              "type": "object",
              "required": [
                "mean",
                "unstable_share"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "unstable_share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "candidate": {
              "type": "object",
              "required": [
                "mean",
                "unstable_share"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "unstable_share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "changes_on_unstable_ids": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "jaccard_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label_changes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "removed",
              "added"
            ],
            "properties": {
              "removed": {
                "type": "integer",
                "minimum": 0
              },
              "added": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "schema_valid": {
          "type": "object",
          "required": [
            "reference",
            "candidate"
          ],
          "properties": {
            "reference": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "candidate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "score",
                  "label",
                  "labels"
                ]
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "scoreparity",
        "python"
      ],
      "properties": {
        "scoreparity": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    }
  }
}
